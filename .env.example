APP_NAME=PolyScribe
APP_ENV=production
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_PASSWORD=change-me-admin-password
DEMO_PROMPT_LIMIT=5
ACCESS_REMEMBER_MAX_AGE_SECONDS=2592000

# Gemini is used only for text chat and translation.
CHAT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite
GEMINI_RETRY_ATTEMPTS=3
GEMINI_RETRY_BASE_DELAY_SECONDS=1

# Groq is used only for audio/video transcription.
TRANSCRIPTION_PROVIDER=groq
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

DATABASE_PATH=/data/polyscribe.db
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=200
DIRECT_AUDIO_MAX_MB=24
KEEP_UPLOADS=false
FFMPEG_SEGMENT_SECONDS=1200
REQUEST_TIMEOUT_SECONDS=180
MAX_CHAT_CONTEXT_CHARS=60000
