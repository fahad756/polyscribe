APP_NAME=PolyScribe
APP_ENV=production
SECRET_KEY=replace-with-a-long-random-secret
APP_PASSWORD=

# Use "gemini" for an online portfolio demo, or "local" for no hosted AI API.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

LOCAL_WHISPER_MODEL=base
LOCAL_WHISPER_DEVICE=cpu
LOCAL_WHISPER_COMPUTE_TYPE=int8
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Optional paid hosted fallback. Set AI_PROVIDER=openai to use these.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TIMEOUT_SECONDS=180

DATABASE_PATH=/data/polyscribe.db
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=200
DIRECT_AUDIO_MAX_MB=24
KEEP_UPLOADS=false
FFMPEG_SEGMENT_SECONDS=1200
MAX_CHAT_CONTEXT_CHARS=60000
