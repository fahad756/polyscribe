APP_NAME=PolyScribe
APP_ENV=production
SECRET_KEY=replace-with-a-long-random-secret
APP_PASSWORD=

# Provider options:
# - local: free local Ollama chat + faster-whisper transcription
# - gemini: online Gemini API for hosted portfolio demos
# - openai: OpenAI/GPT provider
AI_PROVIDER=local

# Gemini online provider. Set AI_PROVIDER=gemini to use these.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local provider. Set AI_PROVIDER=local to use these.
LOCAL_WHISPER_MODEL=base
LOCAL_WHISPER_DEVICE=cpu
LOCAL_WHISPER_COMPUTE_TYPE=int8
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# OpenAI/GPT provider. Set AI_PROVIDER=openai to use these.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TIMEOUT_SECONDS=180

DATABASE_PATH=/data/polyscribe.db
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=200
DIRECT_AUDIO_MAX_MB=24
KEEP_UPLOADS=false
FFMPEG_SEGMENT_SECONDS=1200
MAX_CHAT_CONTEXT_CHARS=60000
